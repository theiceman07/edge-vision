# Install: sudo cp vision.service /etc/systemd/system/ && sudo systemctl enable --now vision
# Edit User and paths first. Then PROVE it: sudo reboot, and check `systemctl status vision` + dashboard.
[Unit]
Description=Edge vision dashboard
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/cv-edge-computing/app
ExecStart=/home/pi/cv-edge-computing/.venv/bin/python server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
